# Copia a .env y ajusta:  cp .env.example .env
# Genera SECRET_KEY con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Django (obligatoria, sin fallback: sin esto manage.py falla con ValueError)
SECRET_KEY=cambia-esta-clave-en-produccion-genera-una-nueva
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (separados por coma, deben incluir el puerto de Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Local rápido: deja USE_SQLITE=True y no necesitas Postgres.
# A Supabase: pon USE_SQLITE=False y rellena DB_* con Database > Connect > Connection pooling.
# OJO: el host directo db.*.supabase.co es solo IPv6; en redes sin IPv6 usa el pooler
#   DB_HOST=aws-0-xxx.pooler.supabase.com  (IPv4)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
USE_SQLITE=True

# Frontend (Vite, leído en src/services/apiClient.js, debe terminar en /api/)
VITE_API_URL=http://127.0.0.1:8000/api/

# Email (Gmail con contraseña de aplicación) — opcional
# Genera una en: https://myaccount.google.com/apppasswords
# Si dejas EMAIL_HOST_USER vacío, los correos se imprimen en la consola.
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# Usuario Administrador (gestión de usuarios/fotógrafos y moderación de contenido) — opcional
# Se usa con: python manage.py crear_admin
ADMIN_USER=admin
ADMIN_EMAIL=admin@luxars.com
ADMIN_PASSWORD=tu_contraseña_de_administrador
